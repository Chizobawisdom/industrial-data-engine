      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Production Throughput over time",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "bg5goz4kf65fkd"
                      },
                      "spec": {
                        "dataset": "manufacturing",
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "WITH start AS (\r\n    SELECT MIN(ingested_at) AS start_time\r\n    FROM silver.station_visits\r\n),\r\nevents AS (\r\n    SELECT\r\n        date_trunc(\r\n            'minute',\r\n            st.start_time + s.sim_timestamp * INTERVAL '1 minute'\r\n        ) AS minute_bucket\r\n    FROM silver.station_visits AS s\r\n    CROSS JOIN start AS st\r\n    WHERE s.station = 'PACKAGING'\r\n      AND s.action  = 'EXIT'\r\n),\r\nbuckets AS (\r\n    SELECT generate_series(MIN(minute_bucket), MAX(minute_bucket), INTERVAL '1 minute') AS minute_bucket\r\n    FROM events\r\n)\r\nSELECT\r\n    b.minute_bucket AS \"time\",\r\n    COUNT(e.minute_bucket) AS units_processed\r\nFROM buckets AS b\r\nLEFT JOIN events AS e USING (minute_bucket)\r\nGROUP BY b.minute_bucket\r\nORDER BY b.minute_bucket;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
